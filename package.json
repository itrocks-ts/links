{
	"author": {
		"name": "Baptiste Pillot",
		"email": "baptiste@pillot.fr"
	},
	"dependencies": {
		"@itrocks/autocomplete": "latest"
	},
	"description": "Multiple linked objects input and transformers",
	"devDependencies": {
		"sass": "^1.95",
		"typescript": "^6.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./cjs/links.js",
		"./links.js": "./links.js"
	},
	"files": [
		"LICENSE",
		"README.md",
		"cjs",
		"css",
		"*.d.ts",
		"*.js",
		"!*.map"
	],
	"homepage": "https://it.rocks",
	"keywords": [
		"backend",
		"collection",
		"component",
		"field",
		"linked",
		"links",
		"it.rocks",
		"multiple",
		"objects",
		"UI",
		"UX"
	],
	"license": "LGPL-3.0-or-later",
	"name": "@itrocks/links",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/links.git"
	},
	"scripts": {
		"build": "npm run build:back && npm run build:css && npm run build:front && npm run build:html",
		"build:back": "tsc",
		"build:css": "sass --no-source-map src:css",
		"build:front": "tsc -p src/front/tsconfig.json && sed -i 's#../../##g' *.js *.d.ts",
		"build:html": "cp src/*.html cjs/ && cp src/*.html esm/"
	},
	"version": "0.1.1"
}
